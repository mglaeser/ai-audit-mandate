root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The mandate volumes are hash-attested. Trailing-whitespace normalisation would
# change their digests, so editors must leave them exactly as committed.
[mandate/*.md]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
